<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>777 BITCASE MONEY</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;
 font-family:Arial,sans-serif;
 background:#101323;
 color:white;
 text-align:center;
}
header{
 background:#202b50;
 padding:22px;
 color:#ffd84d;
 font-size:25px;
 font-weight:bold;
}
.container{padding:18px;max-width:500px;margin:auto}
.wallet{
 background:linear-gradient(135deg,#263e72,#151c38);
 padding:25px;
 border-radius:18px;
 margin:18px 0;
}
.balance{font-size:34px;color:#ffe05b;margin:12px}
button{
 border:0;
 border-radius:10px;
 padding:13px 18px;
 margin:6px;
 font-size:16px;
 font-weight:bold;
 cursor:pointer;
}
.action{background:#ffce38;color:#171717}
.game{
 background:#202b50;
 color:white;
 width:43%;
 min-height:90px;
}
.game:active,button:active{opacity:.7}
h2{color:#ffd84d}
#message{color:#ffe05b;min-height:24px}
footer{color:#aaa;padding:25px;font-size:13px}
</style>
</head>
<body>

<header>🎮 777 BITCASE MONEY</header>

<div class="container">

<div class="wallet">
<h2>MY WALLET</h2>
<div class="balance" id="balance">₹1000</div>
<p>Demo Balance Only</p>
<button class="action" onclick="deposit()">Deposit</button>
<button class="action" onclick="withdraw()">Withdraw</button>
</div>

<h2>OUR GAMES</h2>

<div>
<button class="game" onclick="play('Plane Game')">✈️<br>Plane Game</button>
<button class="game" onclick="play('Ludo')">🎲<br>Ludo</button>
<button class="game" onclick="play('Cards')">🃏<br>Cards</button>
<button class="game" onclick="play('Mines')">💣<br>Mines</button>
<button class="game" onclick="play('Wheel')">🎡<br>Wheel</button>
</div>

<p id="message">Welcome to 777 BITCASE MONEY!</p>

</div>

<footer>777 BITCASE MONEY<br>Demo Gaming App</footer>

<script>
let balance=1000;

function updateBalance(){
 document.getElementById("balance").innerText="₹"+balance;
}

function deposit(){
 document.getElementById("message").innerText=
 "Demo only: Real deposits are not available.";
}

function withdraw(){
 document.getElementById("message").innerText=
 "Demo only: Real withdrawals are not available.";
}

function play(game){
 document.getElementById("message").innerText=
 game+" - Coming Soon!";
}
</script>

</body>
</html>
